<?xml version="1.0" encoding="utf-8"?>
<!-- No permissions are declared, and none are needed: the calculator computes entirely
     on device. Adding one later should require justifying it against PRIVACY.md. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- enableOnBackInvokedCallback: predictive back is on by default only when the *device*
         runs Android 16; on Android 13 to 15 (minSdk is 31) the opt-in is this flag, and
         without it those devices take the legacy onBackPressed path — the mode still closes,
         but the in-app shrink preview ModeScaffold is built around never appears and the
         swipe cannot be abandoned. -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Calculator">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="stateAlwaysHidden"
            android:theme="@style/Theme.Calculator">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The system calculator chooser and assistant "open the calculator" route
                 through this, which a preloaded first-party app is expected to answer. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.APP_CALCULATOR" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- Declared on the launcher activity, which is where the system looks for the
                 long-press shortcut list. The three modes named there re-enter this same
                 singleTask activity and arrive at onNewIntent, not onCreate. Their intents
                 name this activity explicitly, so there is no VIEW filter for the numera://
                 scheme they carry: a filter made the intents claimable by any app, and put a
                 chooser between the debug and release builds on every shortcut tap. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
    </application>
</manifest>

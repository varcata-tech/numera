<?xml version="1.0" encoding="utf-8"?>
<!--
  Long-press shortcuts on the launcher icon.

  Only the three modes a user goes to *directly* are here. The calculator itself is the
  icon, and Settings and the date and financial modes are destinations you reach after
  you have already opened the app, so putting them here would only push the useful three
  past the three-or-four slots most launchers show.

  Each intent names its destination twice: an extra, which MainActivity prefers, and the
  same id as the last path segment of the data URI, which survives launchers that drop the
  extras bundle when they restore a pinned shortcut. The extra name is duplicated from
  MainActivity.EXTRA_ROUTE — XML cannot reference a Kotlin constant, so the two move
  together or the shortcut silently opens the plain calculator.

  THIS FILE IS A TEMPLATE, not a resource. app/build.gradle.kts copies it into each
  variant's generated res/xml/ with ${applicationId} replaced by that variant's real
  applicationId — app.numera.calculator in release, app.numera.calculator.debug in debug.

  Each intent names MainActivity explicitly. They were implicit VIEW intents on a numera://
  scheme at first, resolved by an intent-filter on the activity, because a resource file
  cannot expand the ".debug" suffix the debug build type appends. But an implicit intent is
  an open offer: any installed app declaring the same scheme could claim it, and with the
  debug and release builds installed side by side — the normal state of a developer's phone —
  every shortcut tap raised a chooser between two copies of Numera. A @string reference in
  targetPackage does not work either: the system's ShortcutParser resolves intent attributes
  against its *own* resources, not the app's, and stores the unresolved "@2131362132" as the
  package name, so the shortcut points at an app that does not exist. Only a literal works,
  hence the template. targetClass is the activity's fully qualified name, which does not
  change with the applicationId.
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <shortcut
        android:enabled="true"
        android:shortcutId="converter"
        android:shortcutLongLabel="@string/shortcut_converter_long"
        android:shortcutShortLabel="@string/shortcut_converter_short">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="${applicationId}"
            android:targetClass="app.numera.calculator.MainActivity"
            android:data="numera://mode/converter">
            <extra
                android:name="app.numera.calculator.extra.ROUTE"
                android:value="converter" />
        </intent>
    </shortcut>

    <shortcut
        android:enabled="true"
        android:shortcutId="programmer"
        android:shortcutLongLabel="@string/shortcut_programmer_long"
        android:shortcutShortLabel="@string/shortcut_programmer_short">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="${applicationId}"
            android:targetClass="app.numera.calculator.MainActivity"
            android:data="numera://mode/programmer">
            <extra
                android:name="app.numera.calculator.extra.ROUTE"
                android:value="programmer" />
        </intent>
    </shortcut>

    <shortcut
        android:enabled="true"
        android:shortcutId="graphing"
        android:shortcutLongLabel="@string/shortcut_graphing_long"
        android:shortcutShortLabel="@string/shortcut_graphing_short">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="${applicationId}"
            android:targetClass="app.numera.calculator.MainActivity"
            android:data="numera://mode/graphing">
            <extra
                android:name="app.numera.calculator.extra.ROUTE"
                android:value="graphing" />
        </intent>
    </shortcut>

</shortcuts>

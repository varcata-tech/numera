<resources>
    <!-- The launcher label. Deliberately the common noun rather than the brand "Numera", so the
         app sits under the name people look for on a home screen; the Play listing is still
         "Numera". Because it is a word and not a brand it is translated: an untranslated
         "Calculator" under a home-screen full of localised labels reads as a foreign app. -->
    <string name="app_name">Calculator</string>
</resources>

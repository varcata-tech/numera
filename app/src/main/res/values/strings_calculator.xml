<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Key glyphs. Mathematical notation is the same in every language, so these are
         deliberately not translated; only the spoken descriptions below are. Digits are
         absent on purpose: they come from DecimalFormatSymbols at runtime so that an
         Arabic locale gets ٧ rather than 7. -->
    <string name="op_add" translatable="false">+</string>
    <string name="op_sub" translatable="false">−</string>
    <string name="op_mul" translatable="false">×</string>
    <string name="op_div" translatable="false">÷</string>
    <string name="op_pct" translatable="false">%</string>
    <string name="op_pow" translatable="false">^</string>
    <string name="op_fact" translatable="false">!</string>
    <string name="op_sqrt" translatable="false">√</string>
    <string name="op_sqr" translatable="false">x²</string>
    <string name="const_pi" translatable="false">π</string>
    <string name="const_e" translatable="false">e</string>
    <string name="fun_sin" translatable="false">sin</string>
    <string name="fun_cos" translatable="false">cos</string>
    <string name="fun_tan" translatable="false">tan</string>
    <string name="fun_arcsin" translatable="false">sin⁻¹</string>
    <string name="fun_arccos" translatable="false">cos⁻¹</string>
    <string name="fun_arctan" translatable="false">tan⁻¹</string>
    <string name="fun_ln" translatable="false">ln</string>
    <string name="fun_log" translatable="false">log</string>
    <string name="fun_exp" translatable="false">eˣ</string>
    <string name="fun_10pow" translatable="false">10ˣ</string>
    <string name="key_paren" translatable="false">( )</string>
    <string name="key_lparen" translatable="false">(</string>
    <string name="key_rparen" translatable="false">)</string>
    <string name="key_eq" translatable="false">=</string>
    <string name="key_del" translatable="false">⌫</string>
    <string name="key_inv" translatable="false">INV</string>

    <!-- DEG and RAD are notation like the glyphs above and are not translated. Adding a
         values-<locale> entry for either fails the build: ExtraTranslation is fatal for a
         translatable="false" resource. AC is the one key label left translatable on purpose,
         so a locale that abbreviates "all clear" differently can do so; today every locale
         keeps "AC". -->
    <string name="mode_deg" translatable="false">DEG</string>
    <string name="mode_rad" translatable="false">RAD</string>
    <string name="key_clear">AC</string>

    <!-- Spoken descriptions. TalkBack must say "divided by", never "÷". -->

<?xml version="1.0" encoding="utf-8"?>
<!--
  The themed-icon variant (Android 13+). The system tints this single silhouette to the
  user's wallpaper palette, so it must carry no colour of its own and no background —
  only the shape. Shipping without it means Numera stays fully coloured on a home screen
  where every other icon has gone monochrome, which reads as a bug rather than a choice.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M38,62 L38,28 L70,62 L70,28"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="10"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M40,74 L68,74"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6"
        android:strokeLineCap="round" />
    <path
        android:pathData="M40,84 L68,84"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6"
        android:strokeLineCap="round" />
</vector>

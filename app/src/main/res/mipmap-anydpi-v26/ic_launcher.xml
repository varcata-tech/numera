<?xml version="1.0" encoding="utf-8"?>
<!--
  Only the anydpi-v26 variant exists, and that is sufficient here: minSdk is 31, so every
  device that can install Numera supports adaptive icons. A density-bucketed PNG fallback
  would be dead weight in the bundle.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
